generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  EMPLOYER
  UNIVERSITY_COORDINATOR
  DEPARTMENT_HEAD
  SYSTEM_ADMINISTRATOR
}

enum EligibilityStatus {
  ELIGIBLE
  PENDING
}

model User {
  userId       String    @id @default(uuid()) @map("user_id")
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         Role
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  student   Student?
  employer  Employer?

  @@map("users")
}

model Student {
  studentId         String            @id @default(uuid()) @map("student_id")
  userId            String            @unique @map("user_id")
  studentCode       String            @unique @map("student_code")
  firstName         String            @map("first_name")
  lastName          String            @map("last_name")
  gpa               Decimal           @db.Decimal(3, 2)
  faculty           String?
  department        String?
  academicYear      Int               @map("academic_year")
  eligibilityStatus EligibilityStatus @default(PENDING) @map("eligibility_status")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("students")
}

model Employer {
  employerId   String   @id @default(uuid()) @map("employer_id")
  userId       String   @unique @map("user_id")
  companyName  String   @map("company_name")
  industry     String?
  website      String?
  contactName  String?  @map("contact_name")
  contactPhone String?  @map("contact_phone")
  isVerified   Boolean  @default(false) @map("is_verified")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)
  jobPosts JobPost[]
  @@map("employers")
}
enum JobPostStatus {
  ACTIVE
  CLOSED
  DRAFT
}

model JobPost {
  jobId               String        @id @default(uuid()) @map("job_id")
  employerId          String        @map("employer_id")
  title               String
  description         String
  location            String?
  minGpa              Decimal       @default(0.00) @db.Decimal(3, 2) @map("min_gpa")
  durationWeeks       Int           @map("duration_weeks")
  applicationDeadline DateTime      @map("application_deadline") @db.Date
  status              JobPostStatus @default(ACTIVE)
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  employer   Employer       @relation(fields: [employerId], references: [employerId], onDelete: Cascade)
  skills     JobPostSkill[]

  @@map("job_posts")
}

model JobPostSkill {
  jobId String @map("job_id")
  skill String

  jobPost JobPost @relation(fields: [jobId], references: [jobId], onDelete: Cascade)

  @@id([jobId, skill])
  @@map("job_post_skills")
}