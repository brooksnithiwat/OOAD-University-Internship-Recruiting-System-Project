{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "ignoreDeprecations": "5.0",
    "types": ["node", "jest"],
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
  "src/**/*.ts",
  "test/**/*.ts",
  "**/*.spec.ts"
]
}
